{
  "name": "spare-qa-assignment",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test:api": "bun test",
    "test:e2e": "bun --bun x playwright test",
    "test:e2e:headed": "bun --bun x playwright test --headed",
    "test:e2e:debug": "bun --bun x playwright test --debug"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
